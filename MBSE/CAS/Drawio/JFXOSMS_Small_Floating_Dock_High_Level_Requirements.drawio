am><diagram name="04 Interfaces" id="new3"><mxGraphModel grid="1" page="1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="i0" value="I01 Producto ↔ dique&#10;Geometría / masa / CG / apoyos&#10;S-001 S-002 S-003 S-010" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="440" height="240" as="geometry" /></mxCell><mxCell id="i1" value="I02 Dique ↔ lastre/control&#10;Niveles / bombas / modos&#10;S-002 S-006 S-008" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="440" height="240" as="geometry" /></mxCell><mxCell id="i2" value="I03 Muelle/remolque ↔ logística&#10;Carga / rampas / anclajes&#10;S-005 S-010" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="1060" y="120" width="440" height="240" as="geometry" /></mxCell><mxCell id="i3" value="I04 Taller ↔ servicios&#10;Potencia / ventilación / datos&#10;S-004 S-008 S-011" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="80" y="450" width="440" height="240" as="geometry" /></mxCell><mxCell id="i4" value="I05 SysML ↔ adaptadores&#10;IDs / unidades / relaciones&#10;S-007 S-009" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="570" y="450" width="440" height="240" as="geometry" /></mxCell><mxCell id="i5" value="I06 Datos ↔ gemelo&#10;Tiempo / calidad / versión&#10;S-007 S-012" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="1060" y="450" width="440" height="240" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="05 Restricciones y parámetros" id="new4"><mxGraphModel grid="1" page="1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="0" value="Hipótesis geométrica&#10;Planta 24 × 16 m; pozo 18 × 6 m&#10;Producto ≤ 12 × 4 m; calado objetivo ≤ 1,2 m&#10;Margen de acceso pendiente de aprobación" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="650" height="220" as="geometry" /></mxCell><mxCell id="1" value="Compatibilidad de recepción&#10;Profundidad sobre apoyos sumergidos&#10;≥ calado de producto + holgura aprobada&#10;Profundidad bajo dique se verifica aparte" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="650" height="220" as="geometry" /></mxCell><mxCell id="2" value="Balance de flotación&#10;Masa total / densidad = volumen desplazado&#10;Francobordo y estabilidad requieren cálculo aparte&#10;Capacidad de elevación pendiente" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="650" height="220" as="geometry" /></mxCell><mxCell id="3" value="Balance de energía&#10;Fuente muelle + almacenamiento + solar&#10;≥ carga y reserva aprobadas&#10;Autonomía solar no establecida" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="820" y="370" width="650" height="220" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="06 Estados y revisión" id="new5"><mxGraphModel grid="1" page="1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="0" value="Configurar&#10;S-001 S-007 S-009" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="310" height="200" as=