<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="01 Requisitos y verificación" id="new2"><mxGraphModel grid="1" page="1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="S-001" value="«requirement» S-001&#10;SHALL verificar la envolvente del producto, apoyos y acceso en cada configuración.&#10;Asignación: M01/M05&#10;Método: CAD / inspección&#10;Evidencia: S-001-EV (pendiente)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="450" height="220" as="geometry" /></mxCell><mxCell id="S-002" value="«requirement» S-002&#10;SHALL definir y aprobar estados de carga, masa/CG, calados, francobordo y estabilidad.&#10;Asignación: M01&#10;Método: Análisis naval&#10;Evidencia: S-002-EV (pendiente)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="550" y="70" width="450" height="220" as="geometry" /></mxCell><mxCell id="S-003" value="«requirement» S-003&#10;SHALL dimensionar fondo, alas, picaderos y uniones para cargas aprobadas.&#10;Asignación: M01&#10;Método: FEM / ensayo&#10;Evidencia: S-003-EV (pendiente)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="1050" y="70" width="450" height="220" as="geometry" /></mxCell><mxCell id="S-004" value="«requirement» S-004&#10;SHALL demostrar compatibilidad entre movimiento/vibración y tolerancias del proceso.&#10;Asignación: M02/M03/M04&#10;Método: Simulación / ensayo&#10;Evidencia: S-004-EV (pendiente)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="50" y="320" width="450" height="220" as="geometry" /></mxCell><mxCell id="S-005" value="«requirement» S-005&#10;SHALL aprobar rampas, anclajes, CG y flotabilidad para cada carga y ruta de transferencia.&#10;Asignación: M05&#10;Método: Análisis / demostración&#10;Evidencia: S-005-EV (pendiente)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="550" y="320" width="450" height="220" as="geometry" /></mxCell><mxCell id="S-006" value="«requirement» S-006&#10;SHALL conservar funciones de protección y autoridad local independientes de recomendaciones de IA.&#10;Asignación: M01/M03&#10;Método: Ensayo de fallos&#10;Evidencia: S-006-EV (pendiente)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="1050" y="320" width="450" height="220" as="geometry" /></mxCell><mxCell id="S-007" value="«requirement» S-007&#10;SHALL vincular resultados a requisito, configuración, modelo, escenario, unidades y versiones.&#10;Asignación: M06&#10;Método: Inspección / ensayo&#10;Evidencia: S-007-EV (pendiente)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="50" y="570" width="450" height="220" as="geometry" /></mxCell><mxCell id="S-008" value="«requirement» S-008&#10;SHALL aprobar balance energético y cargas esenciales para operación normal y degradada.&#10;Asignación: M06&#10;Método: Análisis / ensayo&#10;Evidencia: S-008-EV (pendiente)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="550" y="570" width="450" height="220" as="geometry" /></mxCell><mxCell id="S-009" value="«requirement» S-009&#10;SHALL revisar la semántica extraída de SysML/Drawio antes de generar entradas de simulación.&#10;Asignación: M06&#10;Método: Inspección / ensayo&#10;Evidencia: S-009-EV (pendiente)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="1050" y="570" width="450" height="220" as="geometry" /></mxCell><mxCell id="S-010" value="«requirement» S-010&#10;SHALL separar construcción sobre apoyos secos de recepción de casco flotante.&#10;Asignación: M01/M05&#10;Método: Análisis / demostración&#10;Evidencia: S-010-EV (pendiente)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="50" y="820" width="450" height="220" as="geometry" /></mxCell><mxCell id="S-011" value="«requirement» S-011&#10;SHALL separar procesos incompatibles y autorizar operación simultánea por configuración.&#10;Asignación: M02/M03/M04&#10;Método: Inspección / análisis&#10;Evidencia: S-011-EV (pendiente)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="550" y="820" width="450" height="220" as="geometry" /></mxCell><mxCell id="S-012" value="«requirement» S-012&#10;SHALL identificar activo y sensores, calidad/frescura de datos y calibración antes de declarar gemelo operativo.&#10;Asignación: M06&#10;Método: Ensayo / inspección&#10;Evidencia: S-012-EV (pendiente)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1f0f5;strokeColor=#24556a;" vertex="1" parent="1"><mxGeometry x="1050" y="820" width="450" height="220" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="02 Bloques y conexiones propuestas" id="1"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s" value="«block» Planta S&#10;24 × 16 m conceptuales&#10;Aguas abrigadas" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1f0f5;strokeColor=#24556a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="570" y="40" width="340" height="90" as="geometry" /></mxCell><mxCell id="1" value="M01 Dique&#10;Fondo, alas, lastre y apoyos" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1f0f5;strokeColor=#24556a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="320" height="120" as="geometry" /></mxCell><mxCell id="2" value="M02 Producción ligera&#10;Pods desmontables" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1f0f5;strokeColor=#24556a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="470" y="230" width="320" height="120" as="geometry" /></mxCell><mxCell id="3" value="M03 Mecatrónica&#10;Robots, moto y deportivo" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1f0f5;strokeColor=#24556a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="870" y="230" width="320" height="120" as="geometry" /></mxCell><mxCell id="4" value="M04 Drones&#10;Mesa limpia y bancos" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1f0f5;strokeColor=#24556a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="320" height="120" as="geometry" /></mxCell><mxCell id="5" value="M05 Logística&#10;Puente y remolque anfibio" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1f0f5;strokeColor=#24556a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="320" height="120" as="geometry" /></mxCell><mxCell id="6" value="M06 Gemelo y servicios&#10;Datos, energía y configuración" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1f0f5;strokeColor=#24556a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="870" y="470" width="320" height="120" as="geometry" /></mxCell><mxCell id="t" value="Vista conceptual inspirada en SysML&#10;No es un modelo XMI ejecutable ni cálculo naval" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1f0f5;strokeColor=#24556a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="470" y="720" width="720" height="70" as="geometry" /></mxCell><mxCell id="e0" value="composición propuesta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;" edge="1" parent="1" source="s" target="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="composición propuesta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;" edge="1" parent="1" source="s