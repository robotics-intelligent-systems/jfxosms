  <diagram id="osms-process-02" name="02 — Diseño modular del buque multipropósito">
    <mxGraphModel dx="1840" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;JFXOSMS · Diseño modular asistido por IA para ensamblaje y procesos&lt;/b&gt;&lt;br&gt;02 — Diseño modular del buque multipropósito" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e6fa;strokeColor=#64748b;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1760" height="90" />
        </mxCell>
        <mxCell id="note" value="El diseño del buque precede a su planta alimentaria y se itera con sus cargas. No se infieren dimensiones ni capacidades de conceptos previos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#64748b;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1030" width="1760" height="65" />
        </mxCell>
        <mxCell id="N01" value="&lt;b&gt;N01 · Misión naval y cargas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ayuda humanitaria, planta alimentaria, agua, logística y talleres segregados. Definir perfiles de misión y personas a bordo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="N02" value="&lt;b&gt;N02 · Arquitectura naval MBSE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Casco/compartimentos, propulsión, energía, lastre, navegación, habitabilidad, carga y plantas. Interfaces y autoridad operativa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="N03" value="&lt;b&gt;N03 · Diseño conceptual y alternativas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Comparar casco, distribución general y módulos. Especificar calado, desplazamiento, velocidades y capacidad como presupuestos TBD." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="N04" value="&lt;b&gt;N04 · CAD y empaquetamiento&lt;/b&gt;&lt;br&gt;&lt;br&gt;Modelar casco, cubiertas, rutas de tuberías/cables, ventilación, acceso y retirada de módulos. EBOM y zonas de mantenimiento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="N05" value="&lt;b&gt;N05 · Hidroestática y estabilidad&lt;/b&gt;&lt;br&gt;&lt;br&gt;Casos de carga, masa/CG, trimado, francobordo e integridad de compartimentos. Evaluar cambios de módulos y consumibles." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="N06" value="&lt;b&gt;N06 · Estructura e hidrodinámica&lt;/b&gt;&lt;br&gt;&lt;br&gt;Resistencia/propulsión y esfuerzos globales/locales. Incluir soportes de planta, izado, bloques de dique y cargas de mar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="N07" value="&lt;b&gt;N07 · Potencia y servicios&lt;/b&gt;&lt;br&gt;&lt;br&gt;Balance eléctrico/térmico, agua potable/proceso, frío y residuos. Reservas esenciales y segregación de circuitos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="N08" value="&lt;b&gt;N08 · Diseño para construcción&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bloques de casco, prearmado, penetraciones, tolerancias, soldadura e inspección. Secuencia de montaje y accesibilidad." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="N09" value="&lt;b&gt;N09 · Modelos y revisión de diseño&lt;/b&gt;&lt;br&gt;&lt;br&gt;Co-simular navegación, energía y planta. IA compara opciones; arquitectura naval y responsables aprueban diseño y riesgos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="N10" value="&lt;b&gt;N10 · Fabricación de módulos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trazar materiales, piezas, uniones y pruebas de cada bloque. Equipos y módulos de planta ensayados antes de integración." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="N11" value="&lt;b&gt;N11 · Dique e integración final&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aplicar la ruta de dique flotante de página 03. Registrar distribución de cargas, configuración instalada e inspecciones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="N12" value="&lt;b&gt;N12 · Pruebas y puesta en servicio&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pruebas en seco, puesta a flote y pruebas de puerto/mar escalonadas. Aceptación naval y alimentaria separadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="N01" target="N02">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="N02" target="N03">
