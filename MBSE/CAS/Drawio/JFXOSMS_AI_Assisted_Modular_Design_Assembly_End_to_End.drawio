  <diagram id="osms-process-05" name="05 — Producción preliminar en hangar subterráneo">
    <mxGraphModel dx="1840" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;JFXOSMS · Diseño modular asistido por IA para ensamblaje y procesos&lt;/b&gt;&lt;br&gt;05 — Producción preliminar en hangar subterráneo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e6fa;strokeColor=#64748b;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1760" height="90" />
        </mxCell>
        <mxCell id="note" value="Hangar y elevador son infraestructura propuesta, sin dimensiones ni capacidad asignadas. Gate H10 exige evidencia del sitio; IA no gobierna funciones protectoras." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#64748b;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1030" width="1760" height="65" />
        </mxCell>
        <mxCell id="H01" value="&lt;b&gt;H01 · Requisitos de instalación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Definir proyecto auto/VTOL, dimensiones montadas/desmontadas, masa/CG, turnos y volumen productivo. El edificio tiene su propia línea base." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="H02" value="&lt;b&gt;H02 · Diseño del hangar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Geometría, resistencia civil, gálibos, drenaje/inundación, acceso de emergencia, ventilación, incendio y servicios industriales." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="H03" value="&lt;b&gt;H03 · Layout y simulación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Celdas, almacenes, rutas, izado y metrología. Simular colisiones, evacuación, recursos y colas; IA propone alternativas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="H04" value="&lt;b&gt;H04 · Recepción y suministro&lt;/b&gt;&lt;br&gt;&lt;br&gt;Identificar piezas, lotes y reservas; inspección previa y logística hacia celdas. Separar baterías/materiales y zonas de riesgo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="H05" value="&lt;b&gt;H05 · Fabricación preliminar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Adición, mecanizado, unión y cableado en celdas autorizadas. Registrar piezas, parámetros de proceso y emisiones/ventilación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="H06" value="&lt;b&gt;H06 · Montaje e inspección&lt;/b&gt;&lt;br&gt;&lt;br&gt;Útiles, alineación, fijaciones y subensambles. Control dimensional y registro as-built; retener desviaciones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="H07" value="&lt;b&gt;H07 · Bancos y pruebas locales&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ensayos eléctricos y de actuadores en bancos aptos. No asumir permiso para vuelo ni propulsión de alto riesgo dentro del hangar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="H08" value="&lt;b&gt;H08 · Gate de transporte&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fijar estado de energía, desactivar funciones de movimiento, plegar/desmontar si procede y asegurar equipos para traslado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="H09" value="&lt;b&gt;H09 · Interfaz de elevador&lt;/b&gt;&lt;br&gt;&lt;br&gt;Verificar masa total con cuna, distribución de carga, gálibo, fijación, recorrido y acceso. No equiparar capacidad nominal con compatibilidad." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="H10" value="&lt;b&gt;H10 · Liberar elevación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Equipo de instalación/operador aprueba cargas, puertas/enclavamientos, aislamiento y recuperación ante fallo de energía." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="H11" value="&lt;b&gt;H11 · Elevación supervisada&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transportar a superficie mediante sistema validado, con control local y personal autorizado; registrar estado y llegada segura." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="H12" value="&lt;b&gt;H12 · Transporte hacia embarque&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ruta, vehículo/cuna y sujeción aprobados. Verificar infraestructura y centro de transferencia antes de acceso a la plataforma." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="H01" target="H02">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="H02" target="H03">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="H03" target="H04">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="H04" target="H05">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1595" y="405" />
              <mxPoint x="245" y="405" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="H05" target="H06">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="H06" target="H07">
          <mxGeometry as="geometry" relative="1" />
