  <diagram id="osms-process-08" name="08 — Buque, granjas flotantes y planta alimentaria">
    <mxGraphModel dx="1840" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;JFXOSMS · Diseño modular asistido por IA para ensamblaje y procesos&lt;/b&gt;&lt;br&gt;08 — Buque, granjas flotantes y planta alimentaria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e6fa;strokeColor=#64748b;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1760" height="90" />
        </mxCell>
        <mxCell id="note" value="Producción propuesta: no se presupone autosuficiencia de granjas flotantes. Dimensionar la planta junto con estabilidad, energía y logística del buque." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#64748b;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1030" width="1760" height="65" />
        </mxCell>
        <mxCell id="F01" value="&lt;b&gt;F01 · Demanda y perfiles&lt;/b&gt;&lt;br&gt;&lt;br&gt;Definir población humanitaria o misión espacial, composición nutricional, volumen, almacenamiento, agua, envase y distribución." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="F02" value="&lt;b&gt;F02 · Granjas verticales flotantes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Suministrar cultivos seleccionados con trazabilidad de agua/nutrientes, cosecha e higiene. Evaluar energía, área, clima y rendimiento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="F03" value="&lt;b&gt;F03 · Soya y trigo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Soya, cereal y germen: cultivo/maduración, separación y rendimiento requieren evaluación; suministro terrestre alternativo registrado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="F04" value="&lt;b&gt;F04 · Miel, leche y huevos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Miel: apicultura propia aprobada o proveedor. Leche: cadena ganadera. Huevos: avicultura. No son productos automáticos de cultivo hidropónico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="F05" value="&lt;b&gt;F05 · Recepción a bordo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lotes, proveedores, condición, cadena de frío y aceptación. Retener ingredientes no conformes; separar alérgenos y circuitos sucios/limpios." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="F06" value="&lt;b&gt;F06 · Planta modular higiénica&lt;/b&gt;&lt;br&gt;&lt;br&gt;Módulos de agua, cereales/proteínas, lácteos/ovo y envasado. Segregación física de taller, soldadura, combustibles y productos químicos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="F07" value="&lt;b&gt;F07 · Agua y servicios&lt;/b&gt;&lt;br&gt;&lt;br&gt;Desalinización + acondicionamiento/seguridad del agua. Circuitos potable/proceso separados de lastre y agua técnica; frío, energía y vapor según diseño." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="F08" value="&lt;b&gt;F08 · Recetas y planificación&lt;/b&gt;&lt;br&gt;&lt;br&gt;BOM de ingredientes, unidades, rendimientos, consumos y receta versionada. IA planifica recursos; tecnólogo alimentario aprueba proceso." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="F09" value="&lt;b&gt;F09 · Higiene y control de peligros&lt;/b&gt;&lt;br&gt;&lt;br&gt;Buenas prácticas y plan HACCP específico; identificar peligros/CCP donde corresponda. Parámetros y límites requieren validación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="F10" value="&lt;b&gt;F10 · Proceso y envasado&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rutas de página 09; envases compatibles con producto/destino. Limpieza y cambios de línea aprobados; control de contaminación cruzada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="F11" value="&lt;b&gt;F11 · Calidad y liberación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lote retenido hasta cumplir criterios de inocuidad, nutrición, conservación, etiqueta y envase. Decisión del responsable de calidad." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="F12" value="&lt;b&gt;F12 · Logística y retorno&lt;/b&gt;&lt;br&gt;&lt;br&gt;FEFO, frío cuando aplica, manifiesto y entrega. Rastrear cliente/destino y retirada; residuos/efluentes por circuitos evaluados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="F01" target="F02">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="F02" target="F03">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="F03" target="F04">
          <mxGeometry as="geometry" relative="1" />
