  <diagram id="osms-process-06" name="06 — Transferencia e integración en plataforma MOAB semisumergible">
    <mxGraphModel dx="1840" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;JFXOSMS · Diseño modular asistido por IA para ensamblaje y procesos&lt;/b&gt;&lt;br&gt;06 — Transferencia e integración en plataforma MOAB semisumergible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e6fa;strokeColor=#64748b;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1760" height="90" />
        </mxCell>
        <mxCell id="note" value="MOAB CAD-07 es el concepto de referencia; CAD-02/06 son conceptos relacionados, no el mismo activo. Equipos ilustrados no acreditan capacidad ni habilitación de vuelo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#64748b;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1030" width="1760" height="65" />
        </mxCell>
        <mxCell id="M01" value="&lt;b&gt;M01 · Definir MOAB y misión&lt;/b&gt;&lt;br&gt;&lt;br&gt;MOAB = Modular Offshore Base según CAD-07 (jfxmbdss). Cubierta aeronáutica, hangar interior y elevador ilustrados; definir sitio, configuración y traslado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="M02" value="&lt;b&gt;M02 · Ingeniería de plataforma&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cubierta, módulos flotantes, hangar y elevador interno: verificar envolvente, cargas, estabilidad/lastre, amarres/posicionamiento y utilidades." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="M03" value="&lt;b&gt;M03 · Elegir ruta de transferencia&lt;/b&gt;&lt;br&gt;&lt;br&gt;Comparar rampa/ro-ro, grúa u otra modalidad. No asumir conexión directa hangar–MOAB; diseñar tramo terrestre y marítimo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="M04" value="&lt;b&gt;M04 · Plan de carga y sujeción&lt;/b&gt;&lt;br&gt;&lt;br&gt;Masa/CG con cuna, cargas concentradas, izado/amarre y condición de transporte. Calcular impacto en plataforma y producto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="M05" value="&lt;b&gt;M05 · Simular ventana de operación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Movimientos relativos, viento/oleaje, nivel de agua y restricciones del sitio. Límites medidos y criterios de abortar/recuperar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="M06" value="&lt;b&gt;M06 · Gate de embarque&lt;/b&gt;&lt;br&gt;&lt;br&gt;Autoridad de sitio y plataforma validan estado de máquina, transportador, medios de transferencia y carga; personal fuera de zonas de riesgo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="M07" value="&lt;b&gt;M07 · Transferir y asegurar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Realizar transferencia autorizada; confirmar posición, apoyos y sujeción, inspeccionar daños y actualizar configuración." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="M08" value="&lt;b&gt;M08 · Integración final modular&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recibir en hangar/área de integración MOAB; instalar módulos restantes y verificar interfaces. Elevador MOAB → cubierta requiere validación propia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="M09" value="&lt;b&gt;M09 · Elevador MOAB y pruebas estáticas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Validar traslado interno a cubierta: carga, sujeción, gálibos y enclavamientos propios. Metrología, control y SIL/HIL antes de ensayos autorizados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="M10" value="&lt;b&gt;M10 · Pruebas auto / anfibias&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aplicar gates de movimiento terrestre y flotación, frenado, estanqueidad y recuperación, si la plataforma y el entorno lo permiten." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="M11" value="&lt;b&gt;M11 · Gate VTOL aire / agua&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ensayos acuáticos y de vuelo separados. Validar estructura, control, masa/CG, modos, área de operación y autoridad aeronáutica competente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="M12" value="&lt;b&gt;M12 · Entrega o retorno&lt;/b&gt;&lt;br&gt;&lt;br&gt;Registro as-built, aceptación, traslado y mantenimiento. Cambios de módulos o cargas requieren reevaluar transporte y plataforma." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="M01" target="M02">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="M02" target="M03">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="M03" target="M04">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="M04" target="M05">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1595" y="405" />
              <mxPoint x="245" y="405" />
            </Array>
          </mxGeometry>
        </mxCell>
