  <diagram id="osms-process-09" name="09 — Rutas de agua y productos ovo-lacto-vegetarianos">
    <mxGraphModel dx="1840" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;JFXOSMS · Diseño modular asistido por IA para ensamblaje y procesos&lt;/b&gt;&lt;br&gt;09 — Rutas de agua y productos ovo-lacto-vegetarianos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e6fa;strokeColor=#64748b;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1760" height="90" />
        </mxCell>
        <mxCell id="note" value="P01–P09 son líneas independientes que comparten controles P10–P12. Rutas conceptuales: cada producto necesita proceso, especificación y evidencia propios." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#64748b;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1030" width="1760" height="65" />
        </mxCell>
        <mxCell id="P01" value="&lt;b&gt;P01 · Agua desalinizada envasada&lt;/b&gt;&lt;br&gt;&lt;br&gt;Captación evaluada → pretratamiento → desalinización seleccionada → acondicionamiento/desinfección validada → control de potabilidad → envasado higiénico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="P02" value="&lt;b&gt;P02 · Barras de cereal&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ingredientes aceptados → formulación nutricional → mezcla/conformado → estabilización seleccionada → envase → lote y verificación de conservación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="P03" value="&lt;b&gt;P03 · Carne de soya / proteína texturizada&lt;/b&gt;&lt;br&gt;&lt;br&gt;Insumo de soya aceptado → formulación/texturización o uso de insumo texturizado → proceso validado → conservación y envase. Declarar soya." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="P04" value="&lt;b&gt;P04 · Hamburguesa de gluten&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trigo/gluten trazado → formulación → formado → tratamiento validado → envase/conservación. Producto con gluten, no apto para dieta sin gluten." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="P05" value="&lt;b&gt;P05 · Germen de trigo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cereal trazado → separación/recepción de germen → estabilización validada → protección frente a oxidación → envase. No confundir germen con brotes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="P06" value="&lt;b&gt;P06 · Miel de abeja&lt;/b&gt;&lt;br&gt;&lt;br&gt;Proveedor/apicultura identificada → recepción/control → acondicionamiento autorizado → envasado y trazabilidad. Requisitos específicos según población/destino." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="P07" value="&lt;b&gt;P07 · Leche fresca&lt;/b&gt;&lt;br&gt;&lt;br&gt;Leche recibida de cadena ganadera → tratamiento validado → envasado higiénico → cadena de frío y vida útil comprobada. No declarar estabilidad ambiental." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="P08" value="&lt;b&gt;P08 · Yogurt probiótico&lt;/b&gt;&lt;br&gt;&lt;br&gt;Leche tratada → cultivo identificado → fermentación controlada → enfriado → envase/frío. Verificar identidad/viabilidad del cultivo y vida útil; sin beneficios inventados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="P09" value="&lt;b&gt;P09 · Productos con huevo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ingredientes de huevo aceptados → receta → tratamiento validado → protección posproceso → envase/conservación. Declarar huevo y controlar contaminación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="P10" value="&lt;b&gt;P10 · Módulos e instrumentación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Definir balances de masa/energía, equipos, sensores, puntos de muestreo, limpieza y recetas. No asignar tiempos/temperaturas sin validación del producto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="P11" value="&lt;b&gt;P11 · Agua · envase · alérgenos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ensayos microbiológicos/químicos definidos, hermeticidad y limpieza; segregación/etiquetado de soya, trigo/gluten, leche y huevo según mercado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="P12" value="&lt;b&gt;P12 · Destino y gate de lote&lt;/b&gt;&lt;br&gt;&lt;br&gt;Humanitario: distribución compatible con conservación. Astronautas: reformulación/proceso/envase y calificación de misión separados (página 10)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="e0" value="controles" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="P10" target="P11">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="liberación" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="P11" target="P12">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="osms-process-10" name="10 — Calificación humanitaria y alimentaria espacial">
    <mxGraphModel dx="1840" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;JFXOSMS · Diseño modular asistido por IA para ensamblaje y procesos&lt;/b&gt;&lt;br&gt;10 — Calificación humanitaria y alimentaria espacial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e6fa;strokeColor=#64748b;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1760" height="90" />
        </mxCell>
        <mxCell id="note" value="Referencias: NASA Space Food Systems; FAO GHP/HACCP; WHO desalinated drinking-water. Fuentes y límites de interpretación en docs/ai-modular-design-assembly-process.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#64748b;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1030" width="1760" height="65" />
        </mxCell>
        <mxCell id="Q01" value="&lt;b&gt;Q01 · Especificación común de producto&lt;/b&gt;&lt;br&gt;&lt;br&gt;Definir ración, composición, población, alérgenos, calidad sensorial, envase, conservación y trazabilidad por misión/destino." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="Q02" value="&lt;b&gt;Q02 · Programa de validación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Establecer peligros, proceso y plan de ensayos; muestreo, laboratorio y criterios aprobados por especialistas antes de fabricar para consumo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="Q03" value="&lt;b&gt;Q03 · Ruta humanitaria&lt;/b&gt;&lt;br&gt;&lt;br&gt;Perfil local, agua disponible, cultura alimentaria y preparación. Priorizar productos compatibles con la infraestructura real de distribución." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="Q04" value="&lt;b&gt;Q04 · Distribución humanitaria&lt;/b&gt;&lt;br&gt;&lt;br&gt;Liberación de lote, FEFO, etiquetas, transporte y frío si necesario; registrar entrega y canal de retirada/retroalimentación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="Q05" value="&lt;b&gt;Q05 · Ruta astronautas · requisitos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Autoridad/programa de misión define nutrición, duración, masa/volumen, microgravedad, preparación y tolerancia del envase." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="Q06" value="&lt;b&gt;Q06 · Reformulación y conservación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Evaluar estabilización, deshidratación/liofilización u otra tecnología según producto. Leche fresca/yogurt refrigerado no se convierten automáticamente en ración espacial." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="Q07" value="&lt;b&gt;Q07 · Envase y uso en misión&lt;/b&gt;&lt;br&gt;&lt;br&gt;Evaluar cierre, barrera, compatibilidad con rehidratación y preparación; contención de líquidos/partículas y manejo en el entorno previsto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="Q08" value="&lt;b&gt;Q08 · Vida útil y nutrición&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ensayar inocuidad, conservación nutricional, textura y aceptabilidad durante condiciones/duración de misión. Límites y duración TBD por programa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="Q09" value="&lt;b&gt;Q09 · Yogurt y cultivos candidatos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Si se propone producto fermentado estabilizado, reevaluar viabilidad, calidad y alegaciones; no asumir equivalencia con yogurt fresco." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="Q10" value="&lt;b&gt;Q10 · Revisión y aceptación de misión&lt;/b&gt;&lt;br&gt;&lt;br&gt;Paquete de ensayos y configuración sometido al programa responsable. Prototipo alimentario naval no implica aceptación para vuelo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="Q11" value="&lt;b&gt;Q11 · Producción de lotes calificados&lt;/b&gt;&lt;br&gt;&lt;br&gt;Solo receta/proceso/envase aprobados, control de cambios y genealogía; transporte a integración de misión con condición registrada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="Q12" value="&lt;b&gt;Q12 · Observación y mejora&lt;/b&gt;&lt;br&gt;&lt;br&gt;Datos de distribución/uso → revisión de receta, envase y logística. Revalidar cambios; mantener retirada y bloqueo de lotes no conformes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="e0" value="especificación" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="Q01" target="Q02">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="humanitario" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="Q02" target="Q03">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="lote apto" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="Q03" target="Q04">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" value="espacial" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="Q02" target="Q05">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="695" y="405" />
              <mxPoint x="245" y="405" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="desarrollo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="Q05" target="Q06">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e5" value="envase" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="Q06" target="Q07">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e6" value="ensayos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="Q07" target="Q08">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e7" value="si aplica" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="Q08" target="Q09">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1595" y="690" />
              <mxPoint x="245" y="690" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="evidencia" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="Q08" target="Q10">
