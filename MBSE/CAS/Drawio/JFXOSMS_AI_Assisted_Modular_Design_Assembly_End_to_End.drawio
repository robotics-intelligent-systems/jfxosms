<mxfile host="app.diagrams.net" agent="JFXOSMS high-level modular engineering process" version="24.7.17" type="device">
  <diagram id="osms-process-01" name="01 — Ciclo completo MBSE · CAD · CAM · CAS">
    <mxGraphModel dx="1840" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;JFXOSMS · Diseño modular asistido por IA para ensamblaje y procesos&lt;/b&gt;&lt;br&gt;01 — Ciclo completo MBSE · CAD · CAM · CAS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e6fa;strokeColor=#64748b;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1760" height="90" />
        </mxCell>
        <mxCell id="note" value="Ruta de lectura: izquierda → derecha por fila. Cada liberación depende de evidencia y autoridad del dominio; IA propone y explica." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#64748b;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1030" width="1760" height="65" />
        </mxCell>
        <mxCell id="L01" value="&lt;b&gt;L01 · 01 · Misión y necesidades&lt;/b&gt;&lt;br&gt;&lt;br&gt;Naval, mecatrónica automotriz, aeronave anfibia VTOL, automatización y alimentos. Definir usuario, escenario, entorno, capacidad y límites." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="L02" value="&lt;b&gt;L02 · 02 · Requisitos y riesgos&lt;/b&gt;&lt;br&gt;&lt;br&gt;IDs, funciones, interfaces, presupuestos y aceptación. IA propone con fuentes; responsables revisan y aprueban." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="L03" value="&lt;b&gt;L03 · 03 · Arquitectura modular&lt;/b&gt;&lt;br&gt;&lt;br&gt;Descomponer producto, proceso e instalaciones. Contratos mecánicos, potencia, fluidos, datos y software; variantes controladas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="L04" value="&lt;b&gt;L04 · 04 · Concepto y selección&lt;/b&gt;&lt;br&gt;&lt;br&gt;Comparar alternativas por factibilidad, masa, energía, costo, ensamblaje, mantenimiento e impacto. Gate: concepto seleccionado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="L05" value="&lt;b&gt;L05 · 05 · CAD orientado al ensamblaje&lt;/b&gt;&lt;br&gt;&lt;br&gt;Geometría paramétrica, accesibilidad, tolerancias, uniones, rutas de montaje y útiles. Definir EBOM y configuración." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="L06" value="&lt;b&gt;L06 · 06 · CAS y gemelo digital&lt;/b&gt;&lt;br&gt;&lt;br&gt;Validar modelos físicos, control y flujo productivo; simular incertidumbre, fallos y restricciones de instalaciones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="L07" value="&lt;b&gt;L07 · 07 · Industrialización CAM&lt;/b&gt;&lt;br&gt;&lt;br&gt;MBOM, operaciones, robots/CNC, utillaje, inspección y recetas de proceso. Gate: diseño y plan aprobados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="L08" value="&lt;b&gt;L08 · 08 · Inventario y programación&lt;/b&gt;&lt;br&gt;&lt;br&gt;AI-INV + AI-LINE coordinan materiales y capacidad. Reservas, caducidad, disponibilidad y planes factibles; MES libera." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="L09" value="&lt;b&gt;L09 · 09 · Fabricación y ensamblaje&lt;/b&gt;&lt;br&gt;&lt;br&gt;Celdas segregadas y control local. Historial de pieza/lote, cambios, mediciones y configuración as-built." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="L10" value="&lt;b&gt;L10 · 10 · Integración y verificación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Inspección, pruebas, SIL/HIL y demostraciones según dominio. Retener o retrabajar desviaciones; aprobación independiente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="L11" value="&lt;b&gt;L11 · 11 · Despliegue y operación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Buque/dique; hangar/elevador/MOAB; distribución alimentaria. Autoridad humana y permisos del sitio/operación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="L12" value="&lt;b&gt;L12 · 12 · Mantenimiento y mejora&lt;/b&gt;&lt;br&gt;&lt;br&gt;Eventos reales → comparar observado/simulado/propuesto → actualizar modelos, diseño y planes bajo control de cambios." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="L01" target="L02">
