  <diagram id="osms-process-07" name="07 — IA, automatización industrial y autoridad">
    <mxGraphModel dx="1840" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;JFXOSMS · Diseño modular asistido por IA para ensamblaje y procesos&lt;/b&gt;&lt;br&gt;07 — IA, automatización industrial y autoridad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e6fa;strokeColor=#64748b;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1760" height="90" />
        </mxCell>
        <mxCell id="note" value="Alineado con AI-INV, AI-LINE, AI-DSI y los contratos propuestos del README de JFXOSMS. Todo servicio/adaptador sigue siendo arquitectura propuesta." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#64748b;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1030" width="1760" height="65" />
        </mxCell>
        <mxCell id="I01" value="&lt;b&gt;I01 · Fuentes y configuración&lt;/b&gt;&lt;br&gt;&lt;br&gt;Requisitos, CAD/EBOM, MBOM/recetas, escenarios y mediciones. Versiones, unidades, calidad y derechos de uso." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="I02" value="&lt;b&gt;I02 · Copiloto de ingeniería&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recupera fuentes, propone arquitectura, CAD y planes; explica supuestos, incertidumbre y cambios. Revisión humana antes de liberar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="I03" value="&lt;b&gt;I03 · CAS y gemelo digital&lt;/b&gt;&lt;br&gt;&lt;br&gt;Estados observado, simulado y propuesto separados; scenario_id, asset_id, modelo, semilla y snapshot registrados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="I04" value="&lt;b&gt;I04 · AI-INV · materiales&lt;/b&gt;&lt;br&gt;&lt;br&gt;Proponer reservas/reabastecimiento para BOM y recetas. Restricciones duras: stock, caducidad, proveedor y almacenamiento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="I05" value="&lt;b&gt;I05 · AI-LINE · capacidad&lt;/b&gt;&lt;br&gt;&lt;br&gt;Simular y optimizar secuencias/cadencias con recursos, cuellos de botella, calidad y energía. Comparar contra política base." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="I06" value="&lt;b&gt;I06 · Coordinador de planes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reconciliar inventario y capacidad con plan_revision. Detectar inviabilidad; no relajar silenciosamente límites físicos o de calidad." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="I07" value="&lt;b&gt;I07 · AI-DSI · decisión humana&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mostrar recomendación, evidencia, riesgos y vigencia. Registrar aprobar/rechazar/revisar por rol autorizado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="I08" value="&lt;b&gt;I08 · MES / órdenes y lotes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Liberar planes aprobados; registrar pieza/lote, consumos, genealogía, receta/MBOM y estado de calidad. Idempotencia y revisión esperada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="I09" value="&lt;b&gt;I09 · Gateway industrial&lt;/b&gt;&lt;br&gt;&lt;br&gt;Traducir órdenes validadas mediante adaptadores versionados a controladores. OPC UA u otro protocolo según máquina elegida." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="I10" value="&lt;b&gt;I10 · PLC / robots y protección&lt;/b&gt;&lt;br&gt;&lt;br&gt;Control local, enclavamientos y parada segura según célula. IA/cloud no sustituye funciones protectoras ni modifica libremente recetas críticas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="I11" value="&lt;b&gt;I11 · SCADA y mantenimiento&lt;/b&gt;&lt;br&gt;&lt;br&gt;Alarmas, tendencias y auditoría; calibración y mantenimiento. Calidad del dato y límites de operación antes de usar predicciones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="I12" value="&lt;b&gt;I12 · Mejora y nueva liberación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Comparar evidencia real, recalibrar y evaluar política candidata en simulación/sombra. Aprobar nueva versión; rollback a base validada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="725" width="410" height="220" />
        </mxCell>
