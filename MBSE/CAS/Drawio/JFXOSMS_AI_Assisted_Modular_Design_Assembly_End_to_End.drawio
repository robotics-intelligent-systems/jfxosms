  <diagram id="osms-process-04" name="04 — Ensamblaje naval · automotriz · aeroespacial">
    <mxGraphModel dx="1840" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;JFXOSMS · Diseño modular asistido por IA para ensamblaje y procesos&lt;/b&gt;&lt;br&gt;04 — Ensamblaje naval · automotriz · aeroespacial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e6fa;strokeColor=#64748b;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1760" height="90" />
        </mxCell>
        <mxCell id="note" value="Instalaciones auto/VTOL: hangar subterráneo, elevador y transferencia a MOAB (páginas 05–06). Un módulo naval no se considera apto para vuelo por similitud." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#64748b;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1030" width="1760" height="65" />
        </mxCell>
        <mxCell id="A01" value="&lt;b&gt;A01 · Biblioteca común de módulos&lt;/b&gt;&lt;br&gt;&lt;br&gt;IDs, interfaces, tolerancias, masa/CG y variantes. La reutilización necesita evidencia de compatibilidad por dominio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="A02" value="&lt;b&gt;A02 · Naval&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bloques de casco, propulsión, servicios y planta. Acceso, estanqueidad, estabilidad y construcción sobre apoyos/izado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="A03" value="&lt;b&gt;A03 · Mecatrónica automotriz&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chasis, suspensión, frenos/dirección, batería, drive y electrónica. Ergonomía, uniones y pruebas por configuración." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="A04" value="&lt;b&gt;A04 · Aeronave anfibia VTOL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Variante solicitada: combinar requisitos de VTOL (CAD-09) y anfibio (CAD-08), sin asumir geometría común. Estructura, lift, flotación y modos necesitan diseño." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="A05" value="&lt;b&gt;A05 · Diseño para fabricar/ensamblar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reducir interferencias, diseñar útiles y acceso a fijaciones, inspección y desmontaje. Planificar tolerancias y acumulación dimensional." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="A06" value="&lt;b&gt;A06 · Simulación multidominio&lt;/b&gt;&lt;br&gt;&lt;br&gt;Naval: hidrodinámica. Auto: dinámica/actuación. VTOL: aerodinámica, cargas, flotación y control. Escenarios y modelos calibrados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="A07" value="&lt;b&gt;A07 · CAM y planes de unión&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fabricación aditiva/mecanizado y unión seleccionada por material. Secuencia de operaciones y parámetros aprobados por especialistas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="A08" value="&lt;b&gt;A08 · Recepción e identificación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Verificar material, proveedor, revisión y condición. Seriales y no conformidades antes de incorporar a MBOM." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="A09" value="&lt;b&gt;A09 · Subensambles y metrología&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fabricar y medir estructura, mecanismos y equipos. Registrar uniones, calibración y evidencia; segregación de piezas pendientes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="A10" value="&lt;b&gt;A10 · Integración y control&lt;/b&gt;&lt;br&gt;&lt;br&gt;Integrar mecánica, eléctrica, fluidos y software. Verificar cableado, actuadores, aislamiento y consistencia de configuración." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="A11" value="&lt;b&gt;A11 · Pruebas progresivas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bancos, SIL/HIL y pruebas integradas; para VTOL definir gates independientes de agua, tierra y vuelo. Cada gate requiere evidencia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="A12" value="&lt;b&gt;A12 · Liberación y mantenimiento&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aprobación por responsables del dominio; control as-built, repuestos y reparación. Homologación/aeronavegabilidad pendientes según uso." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="e0" value="naval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="A01" target="A02">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="auto" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="A01" target="A03">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="245" y="130" />
              <mxPoint x="1145" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="VTOL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="A01" target="A04">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="245" y="130" />
              <mxPoint x="1595" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="análisis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="A05" target="A06">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e4" value="plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="A06" target="A07">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e5" value="material" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="A07" target="A08">
