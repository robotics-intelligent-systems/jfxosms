  <diagram id="osms-process-11" name="11 — Hilo digital, gates y verificación">
    <mxGraphModel dx="1840" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;JFXOSMS · Diseño modular asistido por IA para ensamblaje y procesos&lt;/b&gt;&lt;br&gt;11 — Hilo digital, gates y verificación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e6fa;strokeColor=#64748b;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1760" height="90" />
        </mxCell>
        <mxCell id="note" value="La misma disciplina de trazabilidad se aplica a piezas y lotes, con criterios distintos. Ver docs/ai-modular-process-verification.csv." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#64748b;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1030" width="1760" height="65" />
        </mxCell>
        <mxCell id="T01" value="&lt;b&gt;T01 · Necesidad → requisito&lt;/b&gt;&lt;br&gt;&lt;br&gt;mission_id, requirement_id, responsable, criterio y presupuesto. Baseline propuesta: valores/fechas requieren asignación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="T02" value="&lt;b&gt;T02 · Requisito → diseño&lt;/b&gt;&lt;br&gt;&lt;br&gt;asset_id, module_id, CAD_revision e interfaz; EBOM con material, masa y CG. Para alimentos: SKU/ingrediente y receta." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="T03" value="&lt;b&gt;T03 · Diseño → industrialización&lt;/b&gt;&lt;br&gt;&lt;br&gt;MBOM_revision, operation_id, fixture_id y process/recipe_revision. Celdas, personas y restricciones del sitio asignadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="T04" value="&lt;b&gt;T04 · Modelos → decisión&lt;/b&gt;&lt;br&gt;&lt;br&gt;scenario_id, snapshot, policy_version, constraint_revision, recommendation_id y plan_revision. Evidencia de comparación con base." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="T05" value="&lt;b&gt;T05 · Decisión → ejecución&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aprobación por rol, vigencia e idempotencia → MES/gateway. Rechazar incompatibilidad de revisión o violación de límites." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="T06" value="&lt;b&gt;T06 · Ejecución → genealogía&lt;/b&gt;&lt;br&gt;&lt;br&gt;Serial/lote, insumos, operador, equipo, medición/calibración, uniones/proceso y as-built. Estado observado separado del propuesto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="T07" value="&lt;b&gt;T07 · Gate producto y ensamblaje&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sin interferencias; interfaces y tolerancias verificadas; masa/CG y riesgos aprobados; no conformidades cerradas antes de entrega." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="T08" value="&lt;b&gt;T08 · Gate dique y puesta a flote&lt;/b&gt;&lt;br&gt;&lt;br&gt;Compatibilidad, apoyos, carga por fase, estabilidad/lastre y planes aprobados. Registro de pruebas en seco, flotación y puerto/mar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="T09" value="&lt;b&gt;T09 · Gate hangar · elevador · MOAB&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gálibo y carga compatibles, sujeción y ruta validada; plataforma y ventana aprobadas; gates aire/agua/tierra independientes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="T10" value="&lt;b&gt;T10 · Gate alimentario&lt;/b&gt;&lt;br&gt;&lt;br&gt;Plan de higiene/HACCP, agua, proceso, frío/envase y lote conformes. Espacial: aceptación adicional por programa de misión." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="T11" value="&lt;b&gt;T11 · Gestión de fallos y cambios&lt;/b&gt;&lt;br&gt;&lt;br&gt;Retener/retrabajar/rechazar; recetas y políticas revertibles; evaluar impacto de cambios sobre montaje, estabilidad y calificación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="T12" value="&lt;b&gt;T12 · Registro de aceptación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Matriz complementaria de 20 requisitos de proceso, métodos y evidencias previstas. No se reportan equipos desplegados ni ensayos superados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="T01" target="T02">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="T02" target="T03">
          <mxGeometry as="geometry" relative="1" />
