  <diagram id="osms-process-12" name="12 — Trazabilidad a conceptos CAD del portafolio">
    <mxGraphModel dx="1840" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;JFXOSMS · Diseño modular asistido por IA para ensamblaje y procesos&lt;/b&gt;&lt;br&gt;12 — Trazabilidad a conceptos CAD del portafolio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e6fa;strokeColor=#64748b;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1760" height="90" />
        </mxCell>
        <mxCell id="note" value="No se copian imágenes al repositorio JFXOSMS: se enlazan a sus proyectos propietarios y se registra su identidad. Arquitectura propuesta, no informe de implementación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#64748b;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1030" width="1760" height="65" />
        </mxCell>
        <mxCell id="C01" value="&lt;b&gt;C01 · CAD-01 · jfxotbs · hangar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hangar subterráneo: plataforma elevadora, taller, ventilación, sensores y energía. Fuente de H01–H12; capacidades por diseñar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="C02" value="&lt;b&gt;C02 · CAD-02 · jfxotbs · aeropuerto&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mega aeropuerto flotante modular con cubierta y soportes. Referencia relacionada para modularidad/operación; no identifica por sí sola el mismo activo MOAB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="C03" value="&lt;b&gt;C03 · CAD-03 · jfxfmis · granja multinivel&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cultivos verticales, frío, cosecha/logística, recirculación y desalación opcional. Fuente de F02/F05/F07; rendimiento no validado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="C04" value="&lt;b&gt;C04 · CAD-04 · jfxfmis · isla agrícola&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cajones modulares, agricultura aterrazada/invernaderos, tratamiento de agua y energía. Fuente de interfaces granja–buque." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="C05" value="&lt;b&gt;C05 · CAD-05 · jfxfmis · blue economy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Terminal/pista, amarres y corredor de buque de apoyo; muestra cadena marina. Su acuicultura no se integra al catálogo ovo-lacto-vegetariano." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="C06" value="&lt;b&gt;C06 · CAD-06 · jfxai4bss · plataforma&lt;/b&gt;&lt;br&gt;&lt;br&gt;Concepto de plataforma offshore de doble casco/semisumergible: módulos, energía, control, helipuerto y grúa. Referencia de cargas/servicios; no expandirlo a MOAB sin decisión." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="C07" value="&lt;b&gt;C07 · CAD-07 · jfxmbdss · MOAB&lt;/b&gt;&lt;br&gt;&lt;br&gt;Texto explícito: Modular Offshore Base. Cubierta aeronáutica, módulos de flotación, hangar interior y elevador ilustrados. Referencia principal de M01–M12." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="C08" value="&lt;b&gt;C08 · CAD-08 · jfxmbdss · anfibio&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transporte anfibio: fuselaje modular, alas/propulsión, flotadores, almacenamiento H2, fuel-cell y batería. No demuestra VTOL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="C09" value="&lt;b&gt;C09 · CAD-09 · jfxotbs · VTOL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pegasus: lift fans, propulsión de crucero, energía LH2, aviónica y bahía de misión. No demuestra flotación propia. Variante anfibia VTOL requiere integración independiente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="C10" value="&lt;b&gt;C10 · Límites de interpretación&lt;/b&gt;&lt;br&gt;&lt;br&gt;JPEGs conceptuales, no modelos dimensionados. No inferir masa, tamaño, capacidades, rendimiento, patente libre ni certificación desde imágenes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="C11" value="&lt;b&gt;C11 · Contratos entre proyectos&lt;/b&gt;&lt;br&gt;&lt;br&gt;IDs/configuración separados para hangar, elevadores, MOAB, buque, dique y granjas. Registrar cargas y entregas; no asumir emplazamiento ni geometría compartidos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="C12" value="&lt;b&gt;C12 · Fuentes auditables&lt;/b&gt;&lt;br&gt;&lt;br&gt;docs/modular-process-cad-sources.json: commits y blob SHA de nueve referencias revisadas. Documentación: enlaces fijados a revisión y matriz de aplicación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="725" width="410" height="220" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>