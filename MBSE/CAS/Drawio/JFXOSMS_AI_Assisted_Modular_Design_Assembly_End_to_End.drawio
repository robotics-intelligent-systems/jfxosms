  </diagram>
  <diagram id="osms-process-03" name="03 — Construcción e integración en dique seco flotante">
    <mxGraphModel dx="1840" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;JFXOSMS · Diseño modular asistido por IA para ensamblaje y procesos&lt;/b&gt;&lt;br&gt;03 — Construcción e integración en dique seco flotante" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7e6fa;strokeColor=#64748b;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1760" height="90" />
        </mxCell>
        <mxCell id="note" value="Flujo conceptual, no instrucciones de maniobra. Capacidades, apoyos y secuencias dependen del dique/sitio y de sus planes aprobados. Referencia técnica: ABS floating dry docks (ver documentación)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#64748b;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1030" width="1760" height="65" />
        </mxCell>
        <mxCell id="D01" value="&lt;b&gt;D01 · Seleccionar ruta de construcción&lt;/b&gt;&lt;br&gt;&lt;br&gt;A: ensamblar bloques sobre dique emergido apto. B: recibir casco ya flotable y vararlo. Elegir y aprobar una ruta, sin asumir equivalencia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="D02" value="&lt;b&gt;D02 · Compatibilidad buque–dique&lt;/b&gt;&lt;br&gt;&lt;br&gt;Comprobar envolvente, capacidad de elevación y carga, peso/CG, calado de entrada, profundidad del sitio y condición del dique." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="D03" value="&lt;b&gt;D03 · Plan de apoyos y montaje&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ubicar bloques de quilla/laterales y apoyos provisionales sobre estructura resistente. Evaluar reacciones, izados y cada estado de montaje." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="D04" value="&lt;b&gt;D04 · Plan de lastre y estabilidad&lt;/b&gt;&lt;br&gt;&lt;br&gt;Evaluar estabilidad y resistencia del dique + buque por fase, superficies libres, niveles, bombas y respuesta a fallos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="155" width="410" height="220" />
        </mxCell>
        <mxCell id="D05" value="&lt;b&gt;D05 · Autorizar instalación y maniobra&lt;/b&gt;&lt;br&gt;&lt;br&gt;Operador de dique y equipo naval validan planes, clima, amarres, grúas y exclusión de personal. IA solo verifica/proporciona escenarios." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="D06" value="&lt;b&gt;D06 · Preparar dique y servicios&lt;/b&gt;&lt;br&gt;&lt;br&gt;Inspeccionar apoyos, válvulas, bombas, sensores y energía de respaldo. Establecer límites y procedimientos locales aprobados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="D07" value="&lt;b&gt;D07 · Posicionar bloques o casco&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ruta A: izar y alinear módulos. Ruta B: inmersión controlada, entrada/alineación del casco y confirmación de posición." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="D08" value="&lt;b&gt;D08 · Soportar y controlar cargas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ruta B: emerger transfiriendo carga a apoyos. En ambas rutas controlar reacciones, deformación, trimado y variaciones de peso." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="440" width="410" height="220" />
        </mxCell>
        <mxCell id="D09" value="&lt;b&gt;D09 · Integrar y verificar en seco&lt;/b&gt;&lt;br&gt;&lt;br&gt;Unir casco e instalar propulsión, tuberías, cableado y módulos; inspeccionar uniones y estanqueidad con plan de pruebas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="D10" value="&lt;b&gt;D10 · Gate previo a puesta a flote&lt;/b&gt;&lt;br&gt;&lt;br&gt;Confirmar casco íntegro/flotable, cierres, estado de sistemas, masa/CG y retirada de impedimentos. Resolver no conformidades." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="D11" value="&lt;b&gt;D11 · Puesta a flote y salida&lt;/b&gt;&lt;br&gt;&lt;br&gt;Inmersión/lastrado por secuencia aprobada hasta flotación; verificar estanqueidad, trimado y control antes de retirar el buque." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="D12" value="&lt;b&gt;D12 · Pruebas y retorno a dique&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pruebas de puerto/mar y registro as-built. Para mantenimiento o cambio de módulos, recalcular peso, apoyos y límites del siguiente varado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="725" width="410" height="220" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="D01" target="D02">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="D02" target="D03">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#486581;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="D03" target="D04">
