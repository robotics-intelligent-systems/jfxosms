try as="geometry" relative="1" /></mxCell><mxCell id="note_layout" parent="1" value="The layout is intentionally modular: additive cells, inspection, and humanoid assembly cells can be scaled independently. Compact intralogistics enables a microfactory footprint while the control room maintains a unified digital thread." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;" vertex="1"><mxGeometry as="geometry" x="80" y="970" width="3260" height="85" /></mxCell></root></mxGraphModel></diagram><diagram id="e8db5741" name="04_Implementation_Roadmap"><mxGraphModel dx="2500" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" value="Implementation Roadmap — Additive Microfactory with Humanoid Robots&lt;br/&gt;&lt;font style='font-size:11px;'&gt;Phased rollout from pilot cell to integrated production-ready microfactory.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1"><mxGeometry as="geometry" x="40" y="20" width="3400" height="72" /></mxCell><mxCell id="p1" parent="1" value="Phase 1 — Foundation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;" vertex="1"><mxGeometry as="geometry" x="80" y="150" width="580" height="280" /></mxCell><mxCell id="p1_0" parent="1" value="Product families &amp; requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1"><mxGeometry as="geometry" x="105" y="210" width="530" height="32" /></mxCell><mxCell id="p1_1" parent="1" value="Microfactory scop